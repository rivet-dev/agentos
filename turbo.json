{
	"$schema": "https://turbo.build/schema.json",
	"globalEnv": [
		"AGENTOS_PLUGIN_BIN",
		"AGENTOS_SIDECAR_BIN",
		"AGENTOS_TEST_WASM_BACKEND",
		"AGENTOS_SKIP_NATIVE_META_BUILD",
		"AGENTOS_CI_CODE_ONLY_BUILD"
	],
	"globalPassThroughEnv": [
		"CARGO_TARGET_DIR"
	],
	"globalDependencies": [
		"crates/sidecar-protocol/protocol/**",
		"packages/build-tools/scripts/compile-sidecar-protocol.mjs"
	],
	"tasks": {
		"build": {
			"dependsOn": [
				"^build"
			],
			"inputs": [
				"src/**",
				"tsconfig.json",
				"package.json"
			],
			"outputs": [
				"dist/**"
			]
		},
		"check-types": {
			"dependsOn": [
				"^build"
			],
			"inputs": [
				"src/**",
				"tests/**",
				"tsconfig.json",
				"package.json"
			]
		},
		"test": {
			"env": [
				"AGENTOS_E2E_NETWORK",
				"AGENTOS_REQUIRE_UDP_ANCILLARY",
				"AGENTOS_WASM_COMMANDS_DIR",
				"AGENTOS_C_WASM_COMMANDS_DIR"
			],
			"inputs": [
				"src/**",
				"tests/**",
				"software/**/test/**",
				"native/tests/**",
				"scripts/**",
				"package.json"
			],
			"dependsOn": [
				"build",
				"check-types"
			]
		},
		"test:nightly": {
			"env": [
				"AGENTOS_E2E_NETWORK",
				"AGENTOS_REQUIRE_UDP_ANCILLARY",
				"AGENTOS_WASM_COMMANDS_DIR",
				"AGENTOS_C_WASM_COMMANDS_DIR"
			],
			"cache": false,
			"inputs": [
				"src/**",
				"tests/**",
				"software/**/test/**",
				"native/tests/**",
				"scripts/**",
				"package.json"
			],
			"dependsOn": [
				"build",
				"check-types"
			]
		},
		"@rivet-dev/agentos#build": {
			"dependsOn": [
				"^build"
			],
			"inputs": [
				"src/**",
				"scripts/**",
				"tsconfig.json",
				"package.json"
			],
			"outputs": [
				"dist/**",
				"commands/**"
			]
		},
		"@rivet-dev/agentos-toolchain#build": {
			"inputs": [
				"src/**",
				"scripts/**",
				"tsconfig.json",
				"package.json",
				"$TURBO_ROOT$/packages/build-tools/scripts/with-owned-esbuild.mjs"
			]
		},
		"@rivet-dev/agentos-sidecar#build": {
			"cache": false,
			"outputs": []
		}
	}
}
