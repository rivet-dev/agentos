{
	"name": "secure-exec",
	"version": "0.0.1",
	"description": "Secure Node.js execution for AI agents: run untrusted JavaScript and TypeScript in an isolated VM.",
	"license": "Apache-2.0",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./typescript": {
			"types": "./dist/typescript.d.ts",
			"import": "./dist/typescript.js",
			"default": "./dist/typescript.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"homepage": "https://rivet.dev/secure-exec",
	"engines": {
		"node": ">=22.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc",
		"check-types": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@rivet-dev/agentos-core": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^22.10.2",
		"typescript": "^5.7.2",
		"vitest": "^2.1.8",
		"zod": "^4.1.11"
	}
}
