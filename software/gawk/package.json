{
	"name": "@agentos-software/gawk",
	"private": true,
	"version": "0.3.4",
	"type": "module",
	"license": "GPL-3.0-or-later",
	"description": "GNU awk text processing for agentOS VMs",
	"homepage": "https://www.gnu.org/software/gawk/",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"share",
		"README.md",
		"!dist/package",
		"!dist/package.tar"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "agentos-toolchain stage --commands-dir ../../toolchain/target/wasm32-wasip1/release/commands --if-missing skip && node scripts/stage-license.mjs && tsc && agentos-toolchain build",
		"check-types": "tsc --noEmit",
		"test": "vitest run test/ --exclude '**/*.nightly.test.ts' --passWithNoTests",
		"test:nightly": "vitest run test/*.nightly.test.ts --passWithNoTests"
	},
	"devDependencies": {
		"@agentos-software/manifest": "workspace:*",
		"@rivet-dev/agentos-toolchain": "workspace:*",
		"@types/node": "^22.10.2",
		"typescript": "^5.9.2",
		"vitest": "^2.1.9"
	}
}
