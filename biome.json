{
	"$schema": "https://biomejs.dev/schemas/2.4.10/schema.json",
	"files": {
		"includes": [
			"packages/**/*.ts",
			"examples/**/*.ts",
			"secure-exec/**/*.ts",
			"!packages/browser",
			"!packages/runtime-browser",
			"!packages/playground",
			"!_agentos-sibling",
			"!/**/node_modules"
		],
		"ignoreUnknown": true
	},
	"overrides": [
		{
			"includes": [
				"packages/core/src/generated-protocol.ts",
				"packages/agentos-toolchain/src/generated-package-format.ts",
				"packages/core/src/generated/**/*.ts",
				"packages/core/src/sidecar/agentos-acp-protocol.ts"
			],
			"formatter": {
				"enabled": false
			}
		}
	],
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"formatter": {
		"enabled": true,
		"useEditorconfig": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noUselessElse": "off",
				"useNodejsImportProtocol": "error"
			},
			"correctness": {
				"noUnusedImports": "warn"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noControlCharactersInRegex": "off"
			},
			"performance": {
				"useTopLevelRegex": "off"
			},
			"nursery": {
				"noFloatingPromises": "error",
				"noMisusedPromises": "error"
			}
		}
	}
}
