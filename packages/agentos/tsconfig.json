{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"jsx": "react-jsx",
		"skipLibCheck": true,
		"types": ["react", "react-dom"],
		"moduleResolution": "bundler",
		"isolatedModules": true,
		"noEmit": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": ["src", "tests"]
}
