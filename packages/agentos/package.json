{
	"name": "@rivet-dev/agentos",
	"version": "0.0.1",
	"description": "The agentOS runtime SDK.",
	"license": "Apache-2.0",
	"keywords": [
		"rivetkit",
		"agent-os",
		"agentos",
		"runtime"
	],
	"sideEffects": false,
	"files": [
		"dist",
		"assets",
		"package.json"
	],
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"build": "pnpm --dir ../agentos-bindgen check && tsup src/index.ts && pnpm build:tabs",
		"build:tabs": "vite build --config vite.tabs.config.ts",
		"check-types": "pnpm --dir ../agentos-bindgen check && tsc --noEmit",
		"test": "node --import tsx --test tests/*.test.mjs"
	},
	"dependencies": {
		"@radix-ui/react-collapsible": "^1.1.2",
		"@radix-ui/react-scroll-area": "^1.2.2",
		"@tanstack/react-query": "^5.87.1",
		"ghostty-web": "^0.4.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"rivetkit": "catalog:rivetkit"
	},
	"devDependencies": {
		"@rivet-dev/agentos-bindgen": "workspace:*",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"postcss": "^8.4.49",
		"tailwind-merge": "^2.6.0",
		"tailwindcss": "^3.4.17",
		"tsup": "^8.4.0",
		"typescript": "^5.7.3",
		"vite": "^5.4.20"
	}
}
