	"scripts": {
		"check-types": "tsc --noEmit && tsc -p tsconfig.type-tests.json",
		"build": "pnpm run build:protocols && tsc && node scripts/stage-default-software.mjs && pnpm run copy-commands",
		"test": "vitest run --exclude '**/*.nightly.test.ts' --reporter=verbose",
		"test:unit": "vitest run tests/agentos-package.test.ts tests/allowed-node-builtins.test.ts tests/host-functions-zod.test.ts tests/host-functions.test.ts tests/cron-manager.test.ts tests/cron-timer-driver.test.ts tests/exec-timeout.test.ts tests/execution-abort.test.ts tests/generated-protocol.test.ts tests/leak-agent-os-processes.test.ts tests/leak-rpc-client.test.ts tests/mount-descriptors.test.ts tests/mount-reconfigure.test.ts tests/options-schema.test.ts tests/output-replay.test.ts tests/kernel-proxy-dispose.test.ts tests/public-api-exports.test.ts tests/root-filesystem-descriptors.test.ts tests/runtime-compat-mount.test.ts tests/sidecar-client.test.ts tests/sidecar-permission-descriptors.test.ts tests/software-install.test.ts tests/wasm-permission-tiers.test.ts --fileParallelism=false",
		"test:pr": "pnpm test:unit",
		"test:nightly": "vitest run tests/*.nightly.test.ts --reporter=verbose --passWithNoTests",
		"build:sidecar-protocol": "pnpm --dir ../build-tools build:protocol",
		"build:protocols": "pnpm run build:sidecar-protocol",
		"copy-commands": "node scripts/copy-wasm-commands.mjs",
		"prepack": "node scripts/copy-wasm-commands.mjs --require"
	},
