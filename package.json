{
	"name": "@rivet-dev/agentos-workspace",
	"private": true,
	"packageManager": "pnpm@10.13.1",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"start": "pnpm exec turbo watch build",
		"build": "pnpm exec turbo build",
		"test": "pnpm exec turbo test --concurrency=1 --filter='!@rivet-dev/agentos-shell'",
		"test:nightly": "pnpm exec turbo test:nightly --concurrency=1 --filter='!@rivet-dev/agentos-shell'",
		"test:watch": "pnpm exec turbo watch test",
		"check-types": "pnpm exec turbo check-types --only --concurrency=4"
	},
	"devDependencies": {
		"@agentos-software/common": "workspace:*",
		"@agentos-software/ripgrep": "workspace:*",
		"@biomejs/biome": "^2.3",
		"@rivet-dev/agentos-core": "workspace:*",
		"@rivet-dev/agentos-test-harness": "workspace:*",
		"@types/node": "^22.19.15",
		"jszip": "^3.10.1",
		"npm": "^11.18.0",
		"pdf-lib": "^1.17.1",
		"tsx": "^4.21.0",
		"turbo": "^2.5.6",
		"typescript": "^5.9.2"
	},
	"resolutions": {
		"@rivet-dev/agentos-core": "workspace:*"
	},
	"pnpm": {
		"overrides": {
			"@rivetkit/rivetkit-wasm": "2.3.10"
		}
	}
}
