{
	"name": "@rivet-dev/agentos-workspace",
	"private": true,
	"packageManager": "pnpm@10.13.1",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"start": "pnpm exec turbo watch build",
		"build": "pnpm exec turbo build",
		"test": "pnpm exec turbo test --concurrency=1 --filter='!@rivet-dev/agentos-shell'",
		"test:nightly": "pnpm exec turbo test:nightly --concurrency=1 --filter='!@rivet-dev/agentos-shell'",
		"test:watch": "pnpm exec turbo watch test",
		"check-types": "pnpm exec turbo check-types --only --concurrency=4"
	},
	"devDependencies": {
		"@agentos-software/common": "workspace:*",
		"@agentos-software/ripgrep": "workspace:*",
		"@biomejs/biome": "^2.3",
		"@rivet-dev/agentos": "workspace:*",
		"@rivet-dev/agentos-test-harness": "workspace:*",
		"@types/node": "^22.19.15",
		"jszip": "^3.10.1",
		"npm": "^11.18.0",
		"pdf-lib": "^1.17.1",
		"tsx": "^4.21.0",
		"turbo": "^2.9.14",
		"typescript": "^5.9.2",
		"vite": "^6.4.4"
	},
	"resolutions": {
		"@rivet-dev/agentos": "workspace:*"
	},
	"pnpm": {
		"overrides": {
			"@effect/platform-node@4.0.5>@effect/platform-node-shared": "4.0.5",
			"@rivetkit/rivetkit-wasm": "3.0.7",
			"@ai-sdk/provider-utils@3": "^3.0.28",
			"@grpc/grpc-js@1": "^1.14.5",
			"@hono/node-server@1": "^1.19.18",
			"@modelcontextprotocol/sdk@1": "^1.32.0",
			"@protobufjs/utf8@1": "^1.1.1",
			"ajv@6": "^6.14.0",
			"basic-ftp@5": "^5.3.1",
			"body-parser@2": "^2.4.0",
			"brace-expansion@1": "^1.1.21",
			"brace-expansion@2": "^2.1.7",
			"brace-expansion@5": "^5.0.12",
			"fast-copy@4": "^4.1.0",
			"fast-uri@3": "^3.1.9",
			"form-data@4": "^4.0.6",
			"hono@4": "^4.13.16",
			"ip-address@10": "^10.7.4",
			"lodash@4": "^4.18.1",
			"minimatch@3": "^3.1.4",
			"nanoid@3": "^3.3.18",
			"pbkdf2@3": "^3.1.7",
			"postcss@8": "^8.5.23",
			"protobufjs@7": "^7.6.5",
