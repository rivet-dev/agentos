+int ttyname_r(int fd, char *name, size_t size) {
+    if (name == NULL) return EINVAL;
+    if (size == 0 || size > UINT32_MAX) return ERANGE;
+    return (int)__host_tty_get_name((uint32_t)fd, name, (uint32_t)size);
+}
+
+char *ttyname(int fd) {
+    static _Thread_local char name[TTY_NAME_MAX];
+    int rc = ttyname_r(fd, name, sizeof name);
+    if (rc != 0) {
+        errno = rc;
+        return NULL;
+    }
+    return name;
