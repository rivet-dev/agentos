 #include "awk.h"
+
+#if defined(HAVE_POSIX_SPAWNP) && defined(HAVE_SPAWN_H)
+/* Classify shell exec errors only; admission/resource failures stay errors. */
+int
+gawk_spawn_exec_status(int error)
+{
+	if (error == ENOENT) return 127;
+	if (error == EACCES || error == ENOEXEC || error == ENOTDIR ||
+	    error == ELOOP || error == ENAMETOOLONG) return 126;
+	return -1;
+}
+
+/* Use the POSIX spawn API for fork-immediately-followed-by-exec operations.
+ * This does not require a copy of the running interpreter's execution stack. */
+pid_t
+gawk_spawn_shell(const char *command, int input_fd, int output_fd,
+	const int *close_fds, size_t close_count,
+	const sigset_t *mask, const sigset_t *defaults)
+{
+	extern char **environ;
+	posix_spawnattr_t attributes;
+	posix_spawn_file_actions_t actions;
+	sigset_t child_defaults;
+	short flags = POSIX_SPAWN_SETSIGDEF;
+	char *argv[] = { (char *) "sh", (char *) "-c", (char *) command, NULL };
+	pid_t pid = -1;
+	int error = posix_spawnattr_init(&attributes);
+	if (error != 0) { errno = error; return -1; }
+	error = posix_spawn_file_actions_init(&actions);
+	if (error != 0) {
+		int cleanup = posix_spawnattr_destroy(&attributes);
+		if (cleanup != 0) warning(_("destroying spawn attributes: %s"), strerror(cleanup));
+		errno = error;
+		return -1;
+	}
+	if (defaults != NULL) child_defaults = *defaults;
+	else sigemptyset(&child_defaults);
+	sigaddset(&child_defaults, SIGPIPE);
+	error = posix_spawnattr_setsigdefault(&attributes, &child_defaults);
+	if (mask != NULL && error == 0) {
+		error = posix_spawnattr_setsigmask(&attributes, mask);
+		flags |= POSIX_SPAWN_SETSIGMASK;
+	}
+	if (error == 0) error = posix_spawnattr_setflags(&attributes, flags);
+	if (error == 0 && input_fd >= 0)
+		error = posix_spawn_file_actions_adddup2(&actions, input_fd, 0);
+	if (error == 0 && output_fd >= 0)
+		error = posix_spawn_file_actions_adddup2(&actions, output_fd, 1);
+	for (size_t i = 0; error == 0 && i < close_count; i++) {
+		if ((close_fds[i] == 0 && input_fd >= 0) ||
+		    (close_fds[i] == 1 && output_fd >= 0)) continue;
+		error = posix_spawn_file_actions_addclose(&actions, close_fds[i]);
+	}
+	if (error == 0)
+		error = posix_spawnp(&pid, "/bin/sh", &actions, &attributes, argv, environ);
+	int cleanup = posix_spawn_file_actions_destroy(&actions);
+	if (cleanup != 0) warning(_("destroying spawn file actions: %s"), strerror(cleanup));
+	cleanup = posix_spawnattr_destroy(&attributes);
+	if (cleanup != 0) warning(_("destroying spawn attributes: %s"), strerror(cleanup));
+	if (error != 0) { errno = error; return -1; }
+	return pid;
+}
